# Server
PORT=5001
NODE_ENV=development
# Frontend origin allowed by CORS and Socket.IO (must match the deployed frontend exactly)
CLIENT_URL=http://localhost:5173
# Reverse-proxy hops in front of the API (rate limits key on the real client IP). Defaults to 1 in production, 0 otherwise.
# TRUST_PROXY=1
# Auth cookie: production defaults to SameSite=None + Secure (frontend on another site).
# Use lax when the app and API share a site; COOKIE_SECURE=false only for plain-http local stacks.
# COOKIE_SAME_SITE=lax
# COOKIE_SECURE=false

# MongoDB (transactions are used when this is a replica set, e.g. Atlas)
MONGO_URI=mongodb://localhost:27017/teampulse

# JWT: use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string

# Optional services: leave empty to run without them.
# Upstash Redis (caching and rate limiting; without it, both fail open)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini (AI assistant)
GEMINI_API_KEY=
