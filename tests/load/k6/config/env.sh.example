#!/bin/bash
# ─────────────────────────────────────────────────────────────────────────────
# TeamPulse k6 Load Test — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file and source it before running k6:
#
#   cp config/env.sh.example config/env.sh
#   source config/env.sh
#   k6 run scenarios/01-smoke.js
#
# Or pass variables inline:
#   k6 run -e BASE_URL=http://localhost:5001 scenarios/01-smoke.js
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────
export BASE_URL="http://localhost:5001"
export TEST_USER_EMAIL="tony@stark.com"
export TEST_USER_PASSWORD="password123"

# ── Optional (auto-discovered from the API if not set) ────────────────────────
# export PROJECT_ID=""
# export TASK_ID=""
# export COMMENT_ID=""

# ─────────────────────────────────────────────────────────────────────────────
# Redis ON/OFF comparison
# ─────────────────────────────────────────────────────────────────────────────
# The k6 tests do NOT need Redis credentials — they test the API as a black box.
#
# To run Redis ON:  Ensure backend/.env has valid UPSTASH_REDIS_REST_URL and
#                   UPSTASH_REDIS_REST_TOKEN, then restart the server.
#
# To run Redis OFF: Comment out or remove UPSTASH_REDIS_REST_URL and
#                   UPSTASH_REDIS_REST_TOKEN from backend/.env, then restart.
#                   The app's fail-open design bypasses all caching + rate limiting.
#
# Run the same k6 scenario in both modes and compare the results.
# ─────────────────────────────────────────────────────────────────────────────

# ── k6 Web Dashboard (built-in) ──────────────────────────────────────────────
# Uncomment to enable the real-time web dashboard at http://localhost:5665
# export K6_WEB_DASHBOARD=true
# export K6_WEB_DASHBOARD_EXPORT="tests/load/k6/results/dashboard.html"
